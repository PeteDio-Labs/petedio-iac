# {{ ansible_managed }}
# petedio-iac roles/decoy-gw (PET-954). Loads the inet villain_decoys table and nothing else.
[Unit]
Description=nftables table for the Lab Villains decoys (PET-954)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ decoy_gw_nft_file }}
# Forwarding turns on only after the default-drop table is loaded, and off before it is removed.
ExecStartPost=/usr/sbin/sysctl -w net.ipv4.ip_forward=1
ExecReload=/usr/sbin/nft -f {{ decoy_gw_nft_file }}
ExecStop=-/usr/sbin/sysctl -w net.ipv4.ip_forward=0
ExecStop=/usr/sbin/nft delete table inet villain_decoys

[Install]
WantedBy=multi-user.target
