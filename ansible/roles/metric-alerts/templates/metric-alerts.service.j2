[Unit]
Description=Evaluate the lab's PromQL alert rules and post to the Lab-Agent DM
Wants=network-online.target
After=network-online.target prometheus.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/metric-alerts
StateDirectory=metric-alerts
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
