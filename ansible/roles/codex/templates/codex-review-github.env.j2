{{ ansible_managed | comment }}
# The petedio-codex-review App's identity, sourced only by codex-review-broker (PET-553).
#
# 0400 {{ codex_user }}:{{ codex_user }}, beside app.pem. Neither value is a secret on its
# own. They share the key's mode so the broker has one directory to protect.
#
# ⚠ app_id identifies the APP; installation_id identifies its INSTALL on the org. Swapping
# them mints nothing and reports a 404 that reads like a missing App.
#
# Resolved from Vault kv/services/codex-review-app by scripts/deploy-codex-248.sh.
GITHUB_APP_ID={{ codex_review_app_id }}
GITHUB_INSTALLATION_ID={{ codex_review_installation_id }}
