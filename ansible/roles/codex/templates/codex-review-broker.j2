#!/usr/bin/env bash
{{ ansible_managed | comment }}
# codex-review-broker (roles/codex, PET-553): the only thing on this host that reads the
# petedio-codex-review App's private key, and the only thing that mints its tokens.
#
# Built from roles/claude-code's claude-code-push-broker, with three differences:
#
#   · The App can read and comment, and nothing more: contents:read, pull_requests:write and
#     metadata:read. It cannot push, and it holds no `workflows` permission. Without write
#     access to a repository, its review never counts toward branch protection.
#   · The App is installed on every repository in {{ codex_github_org }}, so the broker
#     keeps no allow-list. GitHub refuses any repository outside the org.
#   · This file is root-owned under /usr/local/bin, so a run cannot rewrite it.
#
# ⚠ THE KEY IS READABLE BY {{ codex_user }}, BECAUSE THE SESSION IS WHAT REVIEWS. The 0400
# mode keeps other users out, not this one. The App's permissions bound what a leaked key
# or token can do. scripts/seed-codex-review-app.sh checks them before it seeds.
#
# Four subcommands:
#
#   mint-token [repo]  prints one installation token, good for an hour. With a repository
#                      name, the token reaches that repository alone.
#   get                speaks git's credential-helper protocol on stdin and stdout. Every
#                      token it mints is narrowed to the one repository git asked for.
#   store, erase       accepted and ignored, which is all a mint-per-call helper owes git.
set -euo pipefail
umask 077

CONF_DIR={{ codex_review_conf_dir }}
WANT_HOST=github.com
ORG={{ codex_github_org }}

die() { printf 'codex-review-broker: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -ne 0 ] || die "refusing to run as root. Root running git in the session's clone is code execution as root."
[ "$(id -un)" = "{{ codex_user }}" ] || die "must run as {{ codex_user }}, not $(id -un). Only {{ codex_user }} can read $CONF_DIR."
[ $# -ge 1 ] && [ $# -le 2 ] || die "usage: $(basename "$0") mint-token [repo] | get | store | erase"

valid_repo() {
  case "$1" in ''|*/*|*[!A-Za-z0-9._-]*) return 1 ;; esac
}

# The JWT reaches curl on stdin, never in argv, because `ps` reads argv. The window is 540s,
# under GitHub's 600s ceiling. The PEM goes to openssl as a path.
mint() {
  local repo="${1:-}" body='{}'
  if [ -n "$repo" ]; then
    valid_repo "$repo" || die "refusing: '$repo' is not a repository name."
    body="$(printf '{"repositories":["%s"]}' "$repo")"
  fi

  # shellcheck source=/dev/null
  . "$CONF_DIR/github.env"
  for v in GITHUB_APP_ID GITHUB_INSTALLATION_ID; do
    [ -n "${!v:-}" ] || die "$v is missing from $CONF_DIR/github.env. Run scripts/deploy-codex-248.sh."
  done
  PEM_FILE="$CONF_DIR/app.pem"
  [ -r "$PEM_FILE" ] || die "$PEM_FILE is missing or unreadable. Run scripts/deploy-codex-248.sh."

  b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
  now="$(date +%s)"
  h="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  p="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 480))" "$GITHUB_APP_ID" | b64url)"
  sig="$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$PEM_FILE" -binary | b64url)"
  jwt="${h}.${p}.${sig}"

  resp="$(printf 'Authorization: Bearer %s\n' "$jwt" | curl -sS --max-time 20 -X POST \
    -H @- \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    --data-binary "$body" \
    "https://api.github.com/app/installations/${GITHUB_INSTALLATION_ID}/access_tokens")"

  token="$(printf '%s' "$resp" | jq -r '.token // empty' 2>/dev/null || true)"
  [ -n "$token" ] || die "mint failed${repo:+ for $repo}. GitHub said: $(printf '%s' "$resp" | jq -r '.message // .' 2>/dev/null | head -c 200)"
  printf '%s\n' "$token"
}

case "$1" in

mint-token)
  mint "${2:-}"
  ;;

# ⚠ THE HOST, PATH AND ORG CHECKS ARE THE REACH LIMIT. /etc/gitconfig scopes this helper to
# https://github.com, and git sends the path because it sets credential.useHttpPath.
get)
  [ $# -eq 1 ] || die "usage: $(basename "$0") get"
  proto='' host='' path=''
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || break
    case "$line" in
      protocol=*) proto="${line#protocol=}" ;;
      host=*) host="${line#host=}" ;;
      path=*) path="${line#path=}" ;;
    esac
  done
  [ "$proto" = https ] || die "refusing: protocol '$proto' is not https."
  [ "$host" = "$WANT_HOST" ] || die "refusing: host '$host' is not $WANT_HOST."
  [ -n "$path" ] || die "refusing: git sent no path. Set credential.useHttpPath=true."

  repo_path="${path%.git}"
  case "$repo_path" in
    "$ORG"/*) repo="${repo_path#"$ORG"/}" ;;
    *) die "refusing: path '$path' is not under $ORG." ;;
  esac

  token="$(mint "$repo")" || die "could not mint a token for $ORG/$repo."
  # x-access-token is GitHub's fixed username for an installation token.
  printf 'username=x-access-token\npassword=%s\n' "$token"
  ;;

store | erase)
  ;;

*)
  die "unknown subcommand '$1'. Expected mint-token, get, store or erase."
  ;;
esac
