# Managed by Ansible — roles/zot/templates/docker-compose.yml.j2 (petedio-iac).
# Do not edit on the host; edit the template and re-run configure-registry.yml.
#
# zot replaces sonatype/nexus3 on this container. Same host, same NFS-backed
# blob storage, ~2% of the memory.
services:
  zot:
    image: {{ zot_image }}
    container_name: {{ zot_container_name }}
    restart: always
    ports:
      - "{{ zot_port }}:{{ zot_port }}"
    volumes:
      - {{ zot_config_dir }}/config.json:/etc/zot/config.json:ro
      - {{ zot_config_dir }}/htpasswd:/etc/zot/htpasswd:ro
      - {{ zot_data_dir }}:{{ zot_data_dir }}
    healthcheck:
      # /v2/ is the OCI base endpoint; it answers 401 when auth is on, which
      # still proves the server is up and serving the distribution API.
      test: ["CMD-SHELL", "wget -q --spider -T 5 http://localhost:{{ zot_port }}/v2/ 2>&1 | grep -q . || wget -q -O /dev/null -T 5 http://localhost:{{ zot_port }}/v2/ || true"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s
