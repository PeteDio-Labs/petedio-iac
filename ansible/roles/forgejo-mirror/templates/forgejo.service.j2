[Unit]
Description=Forgejo (read-only mirror of {{ forgejo_mirror_org }})
After=network.target

[Service]
User={{ forgejo_user }}
Group={{ forgejo_user }}
WorkingDirectory={{ forgejo_home }}
ExecStart={{ forgejo_bin }} web --config {{ forgejo_conf_dir }}/app.ini
Restart=always
Environment=USER={{ forgejo_user }} HOME={{ forgejo_home }} FORGEJO_WORK_DIR={{ forgejo_home }}
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
