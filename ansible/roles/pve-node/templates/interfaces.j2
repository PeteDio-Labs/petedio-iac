# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!
#
# ⚠ THE HEADER ABOVE IS LOAD-BEARING, and so is the 8-space indentation.
# PVE::INotify owns this file and rewrites it canonically. A bridge stanza it
# does not recognise as PVE-managed is silently DISCARDED on the next rewrite --
# which happens at boot. That is exactly what happened to pve03 on 2026-09-04:
# the role wrote a valid bridge, ifreload applied it, the host answered, and the
# reboot came back with no bridge, no address, and PVE having also claimed the
# WiFi interface as `manual` so NetworkManager would not bring that up either.
# Both NICs down, no route in.
#
# Write this file the way PVE writes it, or PVE will write over it.
# {{ ansible_managed }}

auto lo
iface lo inet loopback

iface {{ pve_node_lan_interface }} inet manual

auto {{ pve_node_bridge }}
iface {{ pve_node_bridge }} inet static
        address {{ pve_node_address }}
        gateway {{ pve_node_gateway }}
        bridge-ports {{ pve_node_lan_interface }}
        bridge-stp off
        bridge-fd 0
{% if pve_node_nameservers | length > 0 %}
        # Without this the node has no resolver at all: the static stanza does
        # not inherit what NetworkManager used to supply, and the first symptom
        # is apt failing with "Temporary failure in name resolution" long after
        # the network itself is fine.
        dns-nameservers {{ pve_node_nameservers | join(' ') }}
{% endif %}
{% for i in ansible_facts["interfaces"] | select("match", "^wl") | sort %}

# PVE writes this stanza itself on every rewrite, so the template matches it
# rather than fighting it. ⚠ It does NOT preserve the NetworkManager route in —
# it is what BREAKS it: NM's ifupdown plugin is managed=false, so any interface
# named in this file is left unmanaged and never comes up. Management is
# asserted back in /etc/NetworkManager/conf.d/05-manage-wireless.conf.
iface {{ i }} inet manual
{% endfor %}

source /etc/network/interfaces.d/*
