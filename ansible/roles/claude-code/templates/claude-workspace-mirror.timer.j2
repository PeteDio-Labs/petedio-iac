{{ ansible_managed | comment }}
# When the {{ claude_workspace_mirror_repo }} mirror refreshes (PET-493).
#
# Half-hourly, offset from the half hour, where the retired work loop's timer fired
# (PET-547). A miss costs nothing: the clone a session works in is behind by design, and
# the session pulls when it needs to.

[Unit]
Description=Periodic refresh of the {{ claude_workspace_mirror_repo }} mirror (PET-493)

[Timer]
OnCalendar={{ claude_workspace_mirror_oncalendar }}

# Runs a missed refresh after a reboot, so a host that was down at the scheduled minute does
# not wait a whole interval. The fetch is idempotent, so a catch-up landing on top of a
# scheduled one costs one wasted fetch and nothing else.
Persistent=true

# Spreads this off the other timers on the host and off the minute boundary.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
