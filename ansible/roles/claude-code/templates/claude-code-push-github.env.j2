{{ ansible_managed | comment }}
# The code-push App's identity, sourced only by claude-code-push-broker (PET-507).
#
# 0400 {{ claude_user }}:{{ claude_user }}, beside app.pem. Neither value is a secret on its
# own. They share the key's mode so the broker has one directory to protect.
#
# ⚠ THE MODE KEEPS OTHER USERS OUT, NOT THIS ONE, by design: the session is what pushes.
# templates/claude-code-push-broker.j2 has the full argument.
#
# ⚠ app_id identifies the APP; installation_id identifies its INSTALL on the three
# repositories. Swapping them mints nothing and reports a 404 that reads like a missing App.
#
# Resolved from Vault kv/services/claude-code-push by scripts/deploy-claude-247.sh. Never a
# committed default: see the identity block in roles/claude-code/defaults/main.yml.
GITHUB_APP_ID={{ claude_code_push_app_id }}
GITHUB_INSTALLATION_ID={{ claude_code_push_installation_id }}
