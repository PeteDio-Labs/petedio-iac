{{ ansible_managed | comment }}
# One tick of the ticket-driven work loop (PET-399), triggered by claude-loop.timer.
#
# Runs AS {{ claude_user }}, which is not a convenience: the Plane connector and the
# claude.ai login are bound to that user's interactive session, and a different service
# user loses both. It is also why the loop's two secrets are NOT handed to this unit
# through `EnvironmentFile=` — a session in bypassPermissions owns this uid and can read
# /proc/<pid>/environ while a tick runs. The tick asks a root-owned broker instead, and
# nothing secret appears below.
#
# Type=oneshot: a tick does at most one work item and exits. The timer decides when the
# next one happens; the tick's own flock decides whether it may start at all.

[Unit]
Description=One tick of the Claude Code work loop (PET-399)
Documentation=file://{{ claude_workspace }}/{{ claude_loop_project_dir }}/docs/runbooks/claude-loop.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ⚠ RUNS AS ROOT, AND DROPS PRIVILEGE ITSELF (PET-408). There is no User= here on purpose.
#
# The obvious shape — User={{ claude_user }} plus a sudoers grant for the broker — was
# tried and is broken. sudo binds a grant to the UID, not to a process, so the `claude -p`
# session this unit starts held exactly the same grant as the tick that started it. That
# session's instructions come from a Plane work item, so anyone who could write one could
# mint the GitHub token directly and skip every guard in the script.
#
# So the tick runs as root, reads {{ claude_loop_conf_dir }} directly, and calls
# `runuser -u {{ claude_user }}` for the two things that must not be root: the session, and
# every command that touches the working tree. The token exists only on the root side.
# There is now NO sudoers entry on this host, which restores this role's original rule that
# the session user gets no sudo at all.
WorkingDirectory={{ claude_loop_home }}

# ⚠ PATH IS SET EXPLICITLY, and it has to be. Debian's .bashrc returns early for
# non-interactive shells, so the line the role appends there is invisible to systemd —
# which is exactly the trap that makes a working host report as broken (docs/GOTCHAS.md).
# {{ claude_npm_prefix }}/bin must come first so the tick runs the same Claude Code an
# operator gets over SSH, including whatever version its auto-updater has moved to.
# HOME stays the LOOP USER's home even though this unit is root: runuser -u does not set
# it, and the session's claude.ai login lives in {{ claude_home }}/.claude. A root HOME here
# would make `claude -p` look for credentials in /root and fail as "not logged in".
Environment=HOME={{ claude_home }}
Environment=PATH={{ claude_npm_prefix }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLAUDE_BIN={{ claude_npm_prefix }}/bin/claude
Environment=CLAUDE_LOOP_HOME={{ claude_loop_home }}
Environment=CLAUDE_LOOP_CHECKOUT={{ claude_loop_home }}/{{ claude_loop_project_dir }}
Environment=CLAUDE_LOOP_BROKER={{ claude_loop_broker }}
Environment=CLAUDE_LOOP_USER={{ claude_user }}
Environment=CLAUDE_LOOP_REPO={{ claude_loop_repo }}
# The remote the tick will accept before it mints a token. Stated rather than assumed: the
# `claude -p` session owns the clone and can repoint origin, so the tick compares against
# this and refuses to mint for anything else (PET-409).
Environment=CLAUDE_LOOP_REMOTE=https://github.com/{{ claude_loop_repo }}
Environment=CLAUDE_LOOP_MAX_ATTEMPTS={{ claude_loop_max_attempts }}
Environment=CLAUDE_LOOP_TIMEOUT_SEC={{ claude_loop_timeout_sec }}
Environment=CLAUDE_LOOP_MAX_AGE_SEC={{ claude_loop_max_age_sec }}

ExecStart=/usr/bin/env bash {{ claude_loop_home }}/claude-loop-tick.sh

# Safe to set now that nothing here calls sudo. It was false while the tick depended on a
# sudoers grant; that grant is gone (PET-408), and `runuser` drops privilege rather than
# raising it, so no child ever needs to gain one.
NoNewPrivileges=true
#
# NO OTHER SANDBOXING DIRECTIVES, deliberately. The sibling claude-remote-*.service carries
# none either, and adding ProtectSystem/PrivateTmp here would be untested hardening around
# a Node process whose temp and socket behaviour nobody has checked under them. The
# boundary that matters on this host is the privilege drop above, not a systemd sandbox —
# if you add one, verify a full tick end to end afterwards, not just that the unit starts.

# The tick boxes `claude -p` with `timeout` at CLAUDE_LOOP_TIMEOUT_SEC. This is the outer
# bound on the whole tick, set above it so the inner one reports first and says why — a
# systemd kill leaves no reason in the heartbeat, only a missing tick.
TimeoutStartSec={{ claude_loop_timeout_sec | int + 600 }}

[Install]
WantedBy=multi-user.target
