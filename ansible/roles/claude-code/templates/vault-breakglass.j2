#!/usr/bin/env bash
# {{ ansible_managed }}
# vault-breakglass (PET-714): a one-hour Vault admin shell for {{ claude_operator_user }} on
# this host. environments/homelab/vault-config/breakglass.tf carries the design.
#
#   vault-breakglass            asks for the password and a TOTP code, then opens a shell
#   exit                        ends the shell and revokes the token
#   vault-breakglass CMD ARGS   runs CMD with the token instead of a shell, for at most the
#                               token's remaining TTL, then revokes it (claude-vault, PET-763)
#
# The token lives in this shell's environment only. It is never written to disk (-token-only
# implies -no-store), and claude-ops, another UID with no sudo, cannot read it. Vault ends it
# after an hour whatever happens here, and refuses it from any address but this host's.
set -euo pipefail

[ "$(id -un)" = "{{ claude_operator_user }}" ] || {
  echo "vault-breakglass: run this as {{ claude_operator_user }}, not $(id -un)." >&2
  exit 2
}

export VAULT_ADDR="{{ claude_operator_vault_addr }}"
export VAULT_CACERT="{{ claude_operator_vault_ca_path }}"

# ⚠ THE LOGIN OUTPUT IS NOT ONLY THE TOKEN. With the TOTP enforcement, Vault writes the
# passphrase prompt to stdout, so the capture holds the prompt text and then the token. Taking
# the whole capture as the token made every later vault command fail with "non-printable
# characters" (PET-714). The prompt text is also captured, so it is not shown: enter the code
# when Vault waits after the password.
echo "vault-breakglass: enter the password, then the 6-digit TOTP code (Vault shows no prompt for it)." >&2
login_out="$(/usr/local/bin/vault login -method=userpass -token-only \
  username="{{ claude_operator_vault_username }}")" || {
  echo "vault-breakglass: Vault refused the login." >&2
  exit 1
}
token="$(printf '%s\n' "$login_out" | grep -aoE 'hv[sb]\.[A-Za-z0-9_-]+' | tail -n 1 || true)"
unset login_out
# Refuse anything that is not a bare service or batch token, whatever the output looked like.
[[ "$token" =~ ^hv[sb]\.[A-Za-z0-9_-]+$ ]] || {
  echo "vault-breakglass: the login output held no Vault token; refusing to open a shell." >&2
  exit 1
}

# A notice for every unlock, so one Pedro did not make shows up on his phone. A pete-bot outage
# must not block the unlock, so a failed notice is reported and the shell opens anyway.
/usr/local/bin/notify-pedro "Vault break-glass opened on $(hostname) by $(id -un)${1:+ for $(basename "$1")}" >/dev/null 2>&1 \
  || echo "vault-breakglass: notify-pedro failed; the Vault audit log still records this login." >&2

# A revoke that fails leaves a live admin token until its hour ends, so say so on the screen
# and to Pedro instead of exiting quietly.
revoke() {
  if ! VAULT_TOKEN="$token" /usr/local/bin/vault token revoke -self >/dev/null 2>&1; then
    echo "vault-breakglass: REVOKE FAILED. The token stays valid until Vault ends it, within one hour." >&2
    /usr/local/bin/notify-pedro "Vault break-glass revoke FAILED on $(hostname); the token lives until its hour ends" \
      >/dev/null 2>&1 || true
  fi
}
trap revoke EXIT

if [ "$#" -gt 0 ]; then
  # A command, not a shell (PET-763). It must not outlive the token, so it runs under timeout
  # for the TTL Vault reports. A TTL this script cannot read is a refusal, not a guess: the
  # trap above still revokes the token.
  ttl="$(VAULT_TOKEN="$token" /usr/local/bin/vault token lookup -format=json 2>/dev/null \
    | jq -r '.data.ttl // empty' || true)"
  [[ "$ttl" =~ ^[0-9]+$ ]] && [ "$ttl" -gt 0 ] || {
    echo "vault-breakglass: could not read the token's TTL; refusing to run $1." >&2
    exit 1
  }
  echo "vault-breakglass: running $(basename "$1") with Vault admin for $((ttl / 60)) minutes." >&2
  # --foreground keeps the command on the terminal, which an interactive program needs. Its
  # child processes are not timed out, but the token they hold dies with its TTL anyway.
  rc=0
  VAULT_TOKEN="$token" timeout --foreground --kill-after=30 "$ttl" "$@" || rc=$?
  [ "$rc" -eq 124 ] && echo "vault-breakglass: the token's hour ended, so $(basename "$1") was stopped." >&2
  exit "$rc"
fi

echo "Vault admin for up to one hour. Type exit to end it and revoke the token."
# --norc keeps the PS1 below; TMOUT closes an idle shell after 15 minutes.
VAULT_TOKEN="$token" PS1='[VAULT ADMIN] \u@\h:\w\$ ' TMOUT=900 bash --norc -i || true
