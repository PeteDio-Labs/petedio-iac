{{ ansible_managed | comment }}
# Read by {{ claude_loop_broker }} `next-item`, and by nothing else on this host.
#
# root:root 0400. The session user cannot read this file; it reaches Plane only through the
# broker, which exposes one read-only query and never the PAT. See
# roles/claude-code/templates/claude-loop-broker.j2 for why an EnvironmentFile= would not
# have been enough.
#
# api_key is the SAME PAT that CI already uses from kv/services/plane — no second Plane
# identity, no new credential to rotate. Resolved by scripts/deploy-claude-loop.sh.
PLANE_BASE_URL={{ claude_loop_plane_base_url }}
PLANE_WORKSPACE={{ claude_loop_plane_workspace }}
PLANE_PROJECT_ID={{ claude_loop_plane_project_id }}
PLANE_API_KEY={{ claude_loop_plane_api_key }}
