#!/usr/bin/env bash
{{ ansible_managed | comment }}
# claude-vault-broker — the only thing on this host that reads the vault App's private key,
# and the only thing that ever holds a token for {{ claude_vault_repo }} (PET-498).
#
# ⚠ THIS IS THE FIRST CREDENTIAL ON 247 THAT THE SESSION USER CAN READ. Every other secret
# here — the loop's App key, the Plane PAT, the workspace mirror's App key — is 0400 root
# behind a 0500 root broker, and a session running as {{ claude_user }} with no sudo (PET-408)
# can reach none of them. This one is different, deliberately, because the direction of the
# work is different: the mirror only FETCHES, and root can do that into a bare mirror the
# session later clones from, while the vault is PUSHED TO, and the pushing process is the
# session. A credential the session cannot read is a credential the session cannot push with.
#
# ⚠ SO EVERY PROCESS RUNNING AS {{ claude_user }} CAN PUSH TO THE VAULT. Every Remote Control
# session on this host, and the work loop's `claude -p` as well if claude_loop_enable is ever
# set, can run this script and mint a token for {{ claude_vault_repo }}. The 0400 on the key
# and the 0500 on this file keep OTHER users out. They cannot keep {{ claude_user }} out,
# because {{ claude_user }} is the user this design hands the credential to. Do not read those
# modes as a boundary they are not.
#
# ⚠ WHAT KEEPS THE BLAST RADIUS NARROW IS THE APP, NOT THE MODES. The App is installed on
# {{ claude_vault_repo }} ALONE, with contents:write and metadata:read and nothing else. So the
# worst a session can do with it is write to one repository that already takes unreviewed
# writes: vault `main` carries no branch protection, and Obsidian Git auto-pushes to it from
# the Mac every 10 minutes. The App cannot open a pull request, cannot read a second
# repository, and cannot act as Pedro. Both halves — one installed repository, those two
# permissions — hold in the GitHub UI, where nothing in this repo would notice them changing.
#
# ⚠ THIS IS NOT THE LOOP'S APP AND NOT THE MIRROR'S, AND MUST NOT BECOME EITHER. The loop's
# App carries contents:write and pull_requests:write on petedio-iac; the mirror's is read-only
# on petedio-workspace and is read by ROOT. Pointing this at {{ claude_loop_conf_dir }} or at
# {{ claude_workspace_mirror_conf_dir }} would hand a session a credential for petedio-iac, or
# would put a root-owned key behind a script the session can rewrite. Three Apps, three Vault
# paths, three directories, three brokers.
#
# WHY A BROKER AND NOT A TOKEN ON DISK. The session user can read the key, so this buys less
# than the mirror's broker does — but it still buys the two things worth having. A token is
# minted per push and lives only in this process and the pipe to git, so nothing writes one to
# {{ claude_vault_conf_dir }}, to the clone's git config, or to a command line. And the host
# and path checks below are the reach limit: the credential answers for one repository on one
# host, whatever remote a git command happens to be pointed at.
#
# Two subcommands, one argument, nothing else:
#
#   mint-token  prints ONE installation access token, good for an hour. The play uses it to
#               verify the identity landed, and a human uses it to debug a failing push.
#   get         speaks git's credential-helper protocol on stdin and stdout, so a plain
#               `git push` in {{ claude_workspace }}/{{ claude_vault_dest }} authenticates with
#               no token in argv and none in any config file. `store` and `erase` are accepted
#               and do nothing, which is all a mint-per-call helper owes git.
set -euo pipefail
umask 077

CONF_DIR={{ claude_vault_conf_dir }}
WANT_HOST=github.com
WANT_PATH={{ claude_vault_repo }}.git

die() { printf 'claude-vault-broker: %s\n' "$*" >&2; exit 1; }

# ⚠ INVERTED FROM THE MIRROR'S BROKER, WHICH DEMANDS ROOT. This one must run as
# {{ claude_user }}, because {{ claude_user }} owns $CONF_DIR 0700 and the key inside it 0400.
# Root could read them anyway, and a root git process running inside a directory the sessions
# own is the exact hazard roles/claude-code/README.md warns about: git honours core.sshCommand,
# core.hooksPath and core.fsmonitor from a repository's own config, so a session that rewrites
# its clone's .git/config gets code execution as whoever runs git there next. Refusing root
# here keeps that door shut even if a later play calls this by mistake.
[ "$(id -u)" -ne 0 ] || die "refusing to run as root. $CONF_DIR belongs to {{ claude_user }}, and root running git in the session's clone is code execution as root."
[ "$(id -un)" = "{{ claude_user }}" ] || die "must run as {{ claude_user }}, not $(id -un). Only {{ claude_user }} can read $CONF_DIR."
[ $# -eq 1 ] || die "usage: $(basename "$0") mint-token|get|store|erase"

# ---------------------------------------------------------------------------------- mint
#
# Body carried over from claude-workspace-mirror-broker, which carried it from
# claude-loop-broker. Three things in it are load-bearing and were paid for once already:
#
#   · The JWT window is 540s (iat back-dated 60s, exp 480s out) under GitHub's HARD 600s
#     exp-iat ceiling. It was exactly 600 once — zero margin, and a latent mint failure the
#     first time a clock drifted.
#   · The JWT goes to curl through STDIN (`-H @-`), never argv. For its lifetime the JWT is
#     App-bearer-equivalent, and anything on this host could read it out of
#     /proc/<pid>/cmdline. printf is a bash builtin, so the value never reaches an external
#     process's command line. The token-exchange POST has no body, so stdin is free.
#   · The PEM reaches openssl as a PATH, not as content. A path is not a secret; the 0400
#     mode on the file it names is what keeps other users off the key.
mint() {
  # shellcheck source=/dev/null
  . "$CONF_DIR/github.env"
  for v in GITHUB_APP_ID GITHUB_INSTALLATION_ID; do
    [ -n "${!v:-}" ] || die "$v is missing from $CONF_DIR/github.env"
  done
  PEM_FILE="$CONF_DIR/app.pem"
  [ -r "$PEM_FILE" ] || die "$PEM_FILE is missing or unreadable."
  for t in openssl curl python3; do command -v "$t" >/dev/null || die "$t is not in PATH."; done

  b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

  now="$(date +%s)"
  h="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  p="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 480))" "$GITHUB_APP_ID" | b64url)"
  sig="$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$PEM_FILE" -binary | b64url)"
  jwt="${h}.${p}.${sig}"

  resp="$(printf 'Authorization: Bearer %s\n' "$jwt" | curl -sS --max-time 20 -X POST \
    -H @- \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/${GITHUB_INSTALLATION_ID}/access_tokens")"

  token="$(printf '%s' "$resp" | python3 -c 'import sys,json
try:
    print(json.load(sys.stdin).get("token") or "")
except Exception:
    print("")')"
  [ -n "$token" ] || die "mint failed. GitHub said: $(printf '%s' "$resp" | head -c 200)"
  printf '%s\n' "$token"
}

case "$1" in

mint-token)
  mint
  ;;

# ----------------------------------------------------------------------------------- get
#
# git's credential-helper protocol: it writes `key=value` lines on stdin, ends them with a
# blank line, and reads `username=` and `password=` back. A helper that prints nothing, or
# exits non-zero, tells git it has no credential — with GIT_TERMINAL_PROMPT=0 the push then
# fails instead of blocking on a prompt nobody can answer.
#
# ⚠ THE HOST AND PATH CHECKS ARE THE REACH LIMIT, and they are the only limit this script
# carries that the session cannot read past. `credential.helper` is not URL-scoped in
# the config that sets it, so without these a git command pointed at a second remote would be
# handed a token for it. git sends `path=` only when credential.useHttpPath is true, which the
# clone's config and claude_vault_git_opts both set, so the check is live; the host check
# stands on its own if a caller ever drops that option.
#
# ⚠ EVERY CALLER RESETS THE HELPER LIST FIRST, and the reset is not decoration:
#
#     git -c credential.helper= -c credential.helper=<this script> ...
#
# `credential.helper` is MULTI-VALUED, so `-c credential.helper=<x>` APPENDS to whatever
# /etc/gitconfig and the caller's ~/.gitconfig already configure. An empty value resets the
# list. Measured on git 2.50.1: without the reset a machine with a stored credential answered
# first and git never ran the script at all — so the checks above silently stopped applying.
# claude_vault_git_opts carries the reset for the play, and tasks/vault.yml writes the same
# empty-then-absolute-path pair into the clone's own config for the session's plain `git push`.
get)
  proto='' host='' path=''
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || break
    case "$line" in
      protocol=*) proto="${line#protocol=}" ;;
      host=*) host="${line#host=}" ;;
      path=*) path="${line#path=}" ;;
    esac
  done
  [ "$proto" = https ] || die "refusing: protocol '$proto' is not https."
  [ "$host" = "$WANT_HOST" ] || die "refusing: host '$host' is not $WANT_HOST."
  [ -z "$path" ] || [ "$path" = "$WANT_PATH" ] || die "refusing: path '$path' is not $WANT_PATH."

  token="$(mint)" || die "could not mint a token for $WANT_PATH."
  # x-access-token is GitHub's fixed username for an installation token. The token is the
  # password, and this pipe is the only place it is written.
  printf 'username=x-access-token\npassword=%s\n' "$token"
  ;;

# Nothing to store and nothing to forget: the credential is minted fresh every time and is
# never cached. Exiting 0 silently is the protocol's "handled"; exiting non-zero here would
# make git report a helper failure after a push that had already succeeded.
store | erase)
  ;;

*)
  die "unknown subcommand '$1'. Expected mint-token, get, store or erase."
  ;;
esac
