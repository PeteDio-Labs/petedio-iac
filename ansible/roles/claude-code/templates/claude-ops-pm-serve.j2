#!/bin/bash
{{ ansible_managed | comment }}
# claude-ops-pm-serve: the PM seat's Remote Control server (PET-619), run as
# {{ claude_ops_user }} by claude-remote-pm.service.
#
# NO --continue (PET-624). A plain `remote-control` start brings back every session the last
# server in this directory served, within about 4 hours. `--continue` brings back only the
# session the server started with, can't be combined with --spawn, and runs until that session
# ends, so it held off the spawn server and left every other session offline
# (code.claude.com/docs/en/remote-control). Past the 4 hours, the server starts with no
# sessions, and the seat loses nothing durable: it keeps its state in the vault's pick-up note.
#
# THE STOP REACHES THE CLI DIRECTLY. The server is an `exec`, so it replaces this script and
# receives systemd's SIGTERM itself, as it does in claude-remote-ops.service.
set -u

claude={{ claude_ops_npm_prefix }}/bin/claude
# Every flag goes AFTER `remote-control`: see the header of claude-remote.service.j2.
flags=(--permission-mode {{ claude_ops_permission_mode }} --remote-control-session-name-prefix {{ claude_ops_pm_remote_name }})

# same-dir: the seat is one checkout on main, so a session writes its pick-up note where the
# next one reads it, not on a worktree's side branch.
exec "$claude" remote-control --spawn same-dir "${flags[@]}"
