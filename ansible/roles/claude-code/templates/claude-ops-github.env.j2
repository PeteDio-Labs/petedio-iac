{{ ansible_managed | comment }}
# The claude-ops App's identity, sourced only by claude-ops-github-broker (PET-531).
#
# 0400 {{ claude_ops_user }}:{{ claude_ops_user }}, beside app.pem. Neither value is a secret
# on its own. They share the key's mode so the broker has one directory to protect.
#
# ⚠ app_id identifies the APP; installation_id identifies its INSTALL. Swapping them mints
# nothing and reports a 404 that reads like a missing App.
#
# Resolved from Vault kv/services/claude-ops-github by scripts/deploy-claude-247.sh. Never a
# committed default: see the identity block in roles/claude-code/defaults/main.yml.
GITHUB_APP_ID={{ claude_ops_github_app_id }}
GITHUB_INSTALLATION_ID={{ claude_ops_github_installation_id }}
