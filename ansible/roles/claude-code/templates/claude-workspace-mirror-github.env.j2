{{ ansible_managed | comment }}
# The mirror App's identity, sourced only by claude-workspace-mirror-broker (PET-493).
#
# 0400 root:root, in the same directory as app.pem. Neither of these two is a secret on its
# own — they are identifiers — but they live under the same mode as the key so the broker has
# one directory to protect and one file to source.
#
# ⚠ app_id identifies the APP; installation_id identifies its INSTALL on
# {{ claude_workspace_mirror_repo }}. Swapping them mints nothing and reports a 404 that
# reads like a missing App.
#
# Resolved from Vault kv/services/claude-workspace-mirror by scripts/deploy-claude-247.sh.
# Never a committed default: see the assert in roles/claude-code/tasks/workspace-mirror.yml.
GITHUB_APP_ID={{ claude_workspace_mirror_app_id }}
GITHUB_INSTALLATION_ID={{ claude_workspace_mirror_installation_id }}
