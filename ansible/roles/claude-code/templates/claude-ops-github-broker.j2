#!/usr/bin/env bash
{{ ansible_managed | comment }}
# claude-ops-github-broker — the only thing on this host that reads the claude-ops App's
# private key, and the only thing that mints a token for it (PET-531).
#
# ⚠ BUILT FROM claude-code-push-broker, WITH ONE DELIBERATE DIFFERENCE. code-push answers for
# a fixed, three-repository allow-list; claude-ops is Pedro's own session, installed wherever
# he puts the App under {{ claude_ops_github_org }}, so this broker checks the ORGANIZATION
# only and mints a token for whatever repository git asks for. What bounds it is the App's
# own install list and its permissions (contents:write, pull_requests:write, workflows:write)
# and branch protection — not an allow-list in this file. GitHub refuses a mint for a
# repository the App is not installed on, same as code-push's does for one off its list.
#
# The key is readable by {{ claude_ops_user }} alone. 0400 on the key and 0500 on this file
# keep every OTHER user out; they do not keep {{ claude_ops_user }} out, and are not meant to.
# BOBBERT NEVER RUNS AS {{ claude_ops_user }} — nothing in this role sets a bot identity to
# it, and tasks/claude-ops.yml asserts it differs from {{ claude_user }}.
#
# Four subcommands, the same shape as claude-code-push-broker:
#
#   mint-token [repo]  prints ONE installation token, good for an hour, narrowed to `repo`
#                      when one is given.
#   get                speaks git's credential-helper protocol on stdin and stdout.
#   store, erase       accepted and ignored.
set -euo pipefail
umask 077

CONF_DIR={{ claude_ops_github_conf_dir }}
WANT_HOST=github.com
ORG={{ claude_ops_github_org }}

die() { printf 'claude-ops-github-broker: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -ne 0 ] || die "refusing to run as root. $CONF_DIR belongs to {{ claude_ops_user }}, and root running git in the session's clone is code execution as root."
[ "$(id -un)" = "{{ claude_ops_user }}" ] || die "must run as {{ claude_ops_user }}, not $(id -un). Only {{ claude_ops_user }} can read $CONF_DIR."
[ $# -ge 1 ] && [ $# -le 2 ] || die "usage: $(basename "$0") mint-token [repo] | get | store | erase"

# ---------------------------------------------------------------------------------- mint
#
# Carried over from claude-code-push-broker unchanged: a 540s JWT window under GitHub's 600s
# ceiling, the JWT built on the fly, the PEM read by path, and stdin never carrying a secret.
mint() {
  local repo="${1:-}" body='{}'
  if [ -n "$repo" ]; then
    body="$(printf '{"repositories":["%s"]}' "$repo")"
  fi

  # shellcheck source=/dev/null
  . "$CONF_DIR/github.env"
  for v in GITHUB_APP_ID GITHUB_INSTALLATION_ID; do
    [ -n "${!v:-}" ] || die "$v is missing from $CONF_DIR/github.env"
  done
  PEM_FILE="$CONF_DIR/app.pem"
  [ -r "$PEM_FILE" ] || die "$PEM_FILE is missing or unreadable."
  for t in openssl curl python3; do command -v "$t" >/dev/null || die "$t is not in PATH."; done

  b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

  now="$(date +%s)"
  h="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  p="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 480))" "$GITHUB_APP_ID" | b64url)"
  sig="$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$PEM_FILE" -binary | b64url)"
  jwt="${h}.${p}.${sig}"

  resp="$(printf 'Authorization: Bearer %s\n' "$jwt" | curl -sS --max-time 20 -X POST \
    -H @- \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    --data-binary "$body" \
    "https://api.github.com/app/installations/${GITHUB_INSTALLATION_ID}/access_tokens")"

  token="$(printf '%s' "$resp" | python3 -c 'import sys,json
try:
    print(json.load(sys.stdin).get("token") or "")
except Exception:
    print("")')"
  [ -n "$token" ] || die "mint failed${repo:+ for $repo}. GitHub said: $(printf '%s' "$resp" | head -c 200)"
  printf '%s\n' "$token"
}

case "$1" in

mint-token)
  mint "${2:-}"
  ;;

# ----------------------------------------------------------------------------------- get
#
# git's credential-helper protocol. With GIT_TERMINAL_PROMPT=0 a refusal here fails the
# command instead of blocking on a prompt nobody can answer.
#
# ⚠ THE HOST, PATH AND ORGANIZATION CHECKS ARE THE REACH LIMIT, and every caller resets the
# helper list first (PET-507's measurement on git 2.50.1 holds here unchanged): without that
# reset, a stored credential configured elsewhere answers first and this script never runs.
get)
  [ $# -eq 1 ] || die "usage: $(basename "$0") get"
  proto='' host='' path=''
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || break
    case "$line" in
      protocol=*) proto="${line#protocol=}" ;;
      host=*) host="${line#host=}" ;;
      path=*) path="${line#path=}" ;;
    esac
  done
  [ "$proto" = https ] || die "refusing: protocol '$proto' is not https."
  [ "$host" = "$WANT_HOST" ] || die "refusing: host '$host' is not $WANT_HOST."
  [ -n "$path" ] || die "refusing: git sent no path. Set credential.useHttpPath=true in this clone; this broker answers per-repository, not per-host."

  repo_path="${path%.git}"
  case "$repo_path" in
    "$ORG"/*) repo="${repo_path#"$ORG"/}" ;;
    *) die "refusing: path '$path' is not under $ORG." ;;
  esac
  case "$repo" in */*|'') die "refusing: path '$path' does not name one repository." ;; esac

  token="$(mint "$repo")" || die "could not mint a token for $ORG/$repo. The App may not be installed there."
  # x-access-token is GitHub's fixed username for an installation token.
  printf 'username=x-access-token\npassword=%s\n' "$token"
  ;;

store | erase)
  ;;

*)
  die "unknown subcommand '$1'. Expected mint-token, get, store or erase."
  ;;
esac
