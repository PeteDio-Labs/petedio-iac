{{ ansible_managed | comment }}
# The read-only Proxmox API token, parsed only by pve-get (PET-510).
#
# 0400 {{ claude_user }}:{{ claude_user }}. The mode keeps other users out, not this one, by
# design: every process running as {{ claude_user }} reads the cluster through this token.
# PVEAuditor on / is what bounds it.
#
# Resolved from Vault kv/services/claude-247-pve by scripts/deploy-claude-247.sh. Never a
# committed default: see the identity block in roles/claude-code/defaults/main.yml.
PVE_TOKEN_ID={{ claude_pve_token_id }}
PVE_TOKEN_SECRET={{ claude_pve_token_secret }}
PVE_ENDPOINT={{ claude_pve_endpoint }}
