{{ ansible_managed | comment }}
# claude-ops's SSH client config: codex-248 as codex, where a forced command lets this key
# queue a review and nothing else (PET-591), and the seven media hosts as root with a key
# that opens those hosts alone (PET-725). StrictHostKeyChecking=accept-new trusts a host's
# key on the first connection and pins it after that.
#
# No Proxmox node and no core LXC is here, by design (PET-725): root on either reaches 247,
# and root on hosts is break-glass. Both private keys were generated ON THIS HOST, as
# {{ claude_ops_user }}, and never leave it.
{% for t in claude_ops_ssh_targets %}
Host {{ t.name }}
    HostName {{ t.host }}
    User {{ t.user | default('root') }}
    IdentityFile {{ t.key | default(claude_ops_ssh_key) }}
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    UserKnownHostsFile {{ claude_ops_home }}/.ssh/known_hosts
{% endfor %}
