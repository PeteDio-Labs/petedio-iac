{{ ansible_managed | comment }}
# Read by {{ claude_loop_broker }} `mint-token`, and by nothing else on this host.
#
# root:root 0400, beside app.pem. These two values plus the key ARE the bot identity: they
# sign a JWT that exchanges for a one-hour installation token with contents:write and
# pull_requests:write on {{ claude_loop_repo }}.
#
# ⚠ THOSE ARE ALSO THE PERMISSIONS THAT MERGE. Nothing about the App stops it merging its
# own pull request — `required_approving_review_count: 1` on `main` does, because the App
# cannot approve its own PR. If that count ever drops to zero, this identity can merge
# unreviewed work the same afternoon.
#
# Two things about that control are worth knowing before you change anything on `main`:
# `enforce_admins` is deliberately FALSE (true deadlocks a one-person org — nobody is left
# who can approve), and the App's inability to self-approve is still DESIGNED rather than
# VERIFIED. PET-399 step 0 and docs/runbooks/claude-loop.md.
GITHUB_APP_ID={{ claude_loop_github_app_id }}
GITHUB_INSTALLATION_ID={{ claude_loop_github_installation_id }}
