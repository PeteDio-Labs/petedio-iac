{{ ansible_managed | comment }}
# The vault App's identity, sourced only by claude-vault-broker (PET-498).
#
# 0400 {{ claude_user }}:{{ claude_user }}, in the same directory as app.pem. Neither of these
# two is a secret on its own — they are identifiers — but they live under the same mode as the
# key so the broker has one directory to protect and one file to source.
#
# ⚠ THE MODE HERE KEEPS OTHER USERS OUT, NOT THIS ONE. Unlike the loop's and the mirror's
# identity files, this directory belongs to {{ claude_user }}, so every session on the host can
# read it. That is the design, not a slip: the session is what pushes to
# {{ claude_vault_repo }}. templates/claude-vault-broker.j2 has the full argument.
#
# ⚠ app_id identifies the APP; installation_id identifies its INSTALL on
# {{ claude_vault_repo }}. Swapping them mints nothing and reports a 404 that reads like a
# missing App.
#
# Resolved from Vault kv/services/claude-vault-push by scripts/deploy-claude-247.sh. Never a
# committed default: see the identity block in roles/claude-code/defaults/main.yml.
GITHUB_APP_ID={{ claude_vault_app_id }}
GITHUB_INSTALLATION_ID={{ claude_vault_installation_id }}
