#!/bin/bash
# Managed by Ansible: roles/backup-store (PET-539). vzdump runs this at every phase
# of every backup on this node, through `script:` in /etc/vzdump.conf.
#
# Before vzdump touches a Palworld guest, warn the players and save the world. The
# AdminPassword is read inside the container and never leaves it.
#
# ⚠ This script must never fail a backup: vzdump aborts the guest's backup when a
# hook exits non-zero. Every path exits 0, and the output lands in the task log.
phase="$1" mode="$2" vmid="$3"

[ "$phase" = backup-start ] || exit 0
guests=" {{ backup_store_palworld_guests | join(' ') }} "
case "$guests" in
  *" $vmid "*) ;;
  *) exit 0 ;;
esac

if ! pct exec "$vmid" -- systemctl is-active --quiet palworld 2>/dev/null; then
  echo "palworld-hook: CT $vmid has no running palworld; nothing to save"
  exit 0
fi

# Stop mode takes the server down, and the service is disabled, so it stays down.
if [ "$mode" = stop ]; then
  msg="Nightly backup: the server stops in {{ backup_store_palworld_warn_s }} seconds and stays off until an admin starts it. The world is saving now."
else
  msg="Nightly backup: saving the world. The server stays up."
fi

echo "palworld-hook: CT $vmid ($mode): announcing, waiting {{ backup_store_palworld_warn_s }} s, saving"
pct exec "$vmid" -- env MSG="$msg" WAIT="{{ backup_store_palworld_warn_s }}" bash -s <<'SH' || true
INI={{ backup_store_palworld_ini }}
PW=$(sed -nE 's/.*AdminPassword="([^"]*)".*/\1/p' "$INI")
API=http://127.0.0.1:8212/v1/api
curl -s -m 10 -o /dev/null -w 'announce %{http_code}\n' -u "admin:$PW" \
  -H 'Content-Type: application/json' -d "{\"message\":\"$MSG\"}" "$API/announce"
sleep "$WAIT"
# /save refuses a bodiless POST without Content-Length (HTTP 411).
curl -s -m 60 -o /dev/null -w 'save %{http_code}\n' -u "admin:$PW" \
  -X POST -H 'Content-Length: 0' "$API/save"
SH
exit 0
