# tracerr service environment. MANAGED BY ANSIBLE — edits here are overwritten.
#
# ⚠ No *arr API keys, deliberately. tracerr reads each key on the host that owns it and
# uses it on that host's loopback; nothing here is a media credential. See
# configure-media-dash.yml for why centralising them would have been a regression.
MEDIA_CONTROL_SSH_KEY={{ tracerr_dir }}/.ssh/id_ed25519_tracerr
HOME={{ tracerr_dir }}
# ⚠ THE LAN BIND, AND WHAT MAKES IT SAFE (PET-518). This process holds an SSH key that
# is root on six media hosts, which is exactly why it was loopback-only for so long. It
# now binds tracerr_bind because pete-bot's replacement caller needs to reach it directly,
# and that is safe ONLY because an nftables allowlist — table inet tracerr_allow, loaded by
# tracerr-allowlist.service BEFORE this unit is allowed to start — accepts this port from
# lo and from tracerr_allow_sources only, and resets everything else. Read that table's
# comments (templates/tracerr-allowlist.nft.j2) before touching this bind.
#
# What still holds: the SSH key this process carries is root on six media hosts. NEVER
# widen tracerr_allow_sources to the /24 — that turns one leaked caller token into a path
# to every media container tracerr reaches, which is precisely what the allowlist exists
# to prevent. Add a caller by name, not a subnet.
MEDIA_CONTROL_BIND={{ tracerr_bind }}
MEDIA_CONTROL_PORT={{ tracerr_port }}
# One token per caller, name:token pairs joined by ',' (dictsort order, so this file is
# stable across re-runs when the callers don't change). MEDIA_CONTROL_TOKEN (singular) is
# gone — see configure-media-dash.yml's header for where each field comes from.
MEDIA_CONTROL_TOKENS={{ tracerr_caller_tokens | dictsort | map('join', ':') | join(',') }}

# Callers allowed to use the write tools. Every other caller stays read-only. A name here
# that is not a caller above stops tracerr at startup (src/auth.ts parseWriters).
MEDIA_CONTROL_WRITERS={{ tracerr_write_callers | join(',') }}

# The scheduled search for missing titles (MED-12). With tracerr_schedule 'on' it runs the
# same MoviesSearch and EpisodeSearch commands as search_missing, one title at a time, and
# logs one JSON line per title and one per pass. Any other value leaves it off.
MEDIA_CONTROL_SCHEDULE={{ tracerr_schedule }}
MEDIA_CONTROL_SEARCH_GAP_MS={{ tracerr_search_gap_ms }}
MEDIA_CONTROL_SEARCH_CAP={{ tracerr_search_cap }}
MEDIA_CONTROL_SCHEDULE_LOG={{ tracerr_schedule_log }}

{% if tracerr_mcp_access_aud | length > 0 %}
# The MCP door at /mcp/media (read tools only). All five are required; tracerr stops at
# startup on a partial set. The audience tag is Terraform's media_mcp_subdomain_access_aud.
MEDIA_CONTROL_MCP_PORT={{ tracerr_mcp_port }}
MEDIA_CONTROL_MCP_PEER={{ tracerr_mcp_peer }}
MEDIA_CONTROL_MCP_TEAM={{ tracerr_mcp_access_team_domain }}
MEDIA_CONTROL_MCP_AUD={{ tracerr_mcp_access_aud }}
MEDIA_CONTROL_MCP_EMAILS={{ tracerr_mcp_access_emails | join(',') }}
MEDIA_CONTROL_MCP_AGENTS={% for name, cid in (tracerr_mcp_access_agents | default({})) | dictsort %}{{ cid }}={{ name }}{{ ',' if not loop.last }}{% endfor %}
{% else %}
# tracerr_mcp_access_aud is empty, so the MCP door is off.
{% endif %}

# No OLLAMA_HOST or MEDIA_CONTROL_MODEL: tracerr routes by keyword and calls no model
# (PET-525).
