# petedio-search environment (PET-526). MANAGED BY ANSIBLE: configure-search.yml.
# Holds caller tokens and the Plane API key, so it is root:{{ search_group }} 0640.
HOME={{ search_data }}
SEARCH_DATA_DIR={{ search_data }}
SEARCH_BIND={{ search_bind }}
SEARCH_PORT={{ search_port }}
SEARCH_TOKENS={{ search_caller_tokens | dictsort | map('join', ':') | join(',') }}
OLLAMA_URL={{ search_ollama_url }}
EMBED_MODEL={{ search_embed_model }}
VAULT_REMOTE={{ search_vault_remote }}
# The deploy key and the pinned host key only. BatchMode fails fast instead of prompting.
GIT_SSH_COMMAND=ssh -i {{ search_data }}/.ssh/id_ed25519_vault -o IdentitiesOnly=yes -o UserKnownHostsFile={{ search_data }}/.ssh/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes
DIGEST_URL={{ search_digest_url }}
{% if search_plane_api_key | length > 0 %}
PLANE_BASE_URL={{ search_plane_base_url }}
PLANE_WORKSPACE={{ search_plane_workspace }}
PLANE_PROJECTS={{ search_plane_projects }}
PLANE_API_KEY={{ search_plane_api_key }}
{% else %}
# No plane_api_key at kv/services/search, so refresh skips Plane.
{% endif %}
