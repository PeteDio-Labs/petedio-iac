# {{ ansible_managed }}
# lab-agent — read-only answers about the lab for pete-bot's /lab (PET-669, PET-670).
#
# Read by systemd, as root, before it drops to {{ lab_agent_user }}, so it is 0600 root.
# Every secret here comes from Vault through scripts/deploy-pete-bot.sh or pete-bot's
# deploy.yml: kv/services/lab-agent, kv/services/lab-agent-pve, lab-map's bearer from
# kv/services/pete-bot, and the mirror App's ids from kv/services/claude-workspace-mirror.
# None is defaulted in the play and none appears in the repo.

# POST /v1/ask and GET /health, on 127.0.0.1 only. pete-bot sends this bearer.
LAB_PORT={{ lab_agent_port }}
LAB_ASK_TOKEN={{ lab_agent_ask_token }}

# The model backend (PET-742): qwen3 on ollama-246. The Anthropic gateway is retired (PET-744),
# and lab-agent refuses LAB_PROVIDER=gateway at startup.
LAB_PROVIDER=ollama
LAB_OLLAMA_URL={{ lab_agent_ollama_url }}
LAB_MODEL={{ lab_agent_ollama_model }}

# Proxmox, through lab-agent@pve!audit (PVEAuditor, privilege separation on).
LAB_PVE_URL={{ lab_agent_pve_endpoint }}
LAB_PVE_TOKEN_ID={{ lab_agent_pve_token_id }}
LAB_PVE_TOKEN_SECRET={{ lab_agent_pve_token_secret }}
LAB_PVE_CA_FILE={{ lab_agent_conf_dir }}/pve-root-ca.pem

# Uptime Kuma's status page, read without credentials.
LAB_KUMA_URL=http://192.168.50.4:3001
LAB_KUMA_SLUG=fault-study

# Vault metadata under kv/services/, through a token with the lab-agent-presence policy.
LAB_VAULT_ADDR=https://192.168.50.223:8200
LAB_VAULT_TOKEN={{ lab_agent_vault_token }}
LAB_VAULT_CA_FILE={{ lab_agent_conf_dir }}/vault-ca.pem

# The nightly drift check (PET-671) DMs through pete-bot's /v1/notify. This is pete-bot's
# notify bearer, which opens that route alone and cannot post an alert (PET-584).
LAB_NOTIFY_URL=http://127.0.0.1:{{ pete_bot_port }}/v1/notify
LAB_NOTIFY_TOKEN={{ pete_bot_notify_bearer }}
LAB_DRIFT_AT=11:15

# Plane on 235, for the plane_item tool (PET-672). From kv/services/lab-agent-plane. Absent
# while the token is unseeded, and then lab-agent offers no plane_item.
{% if (lab_agent_plane_token | default('')) | length > 0 %}
LAB_PLANE_TOKEN={{ lab_agent_plane_token }}
{% endif %}

# petedio-search on ollama-246, for the search_lab tool (PET-745). From
# kv/services/lab-agent-search. Absent while the token is unseeded, and then lab-agent offers
# no search_lab.
{% if (lab_agent_search_token | default('')) | length > 0 %}
LAB_SEARCH_URL={{ lab_agent_search_url }}
LAB_SEARCH_TOKEN={{ lab_agent_search_token }}
{% endif %}

# pete-bot's /health, for the desk_status tool.
LAB_DESK_HEALTH_URL=http://127.0.0.1:{{ pete_bot_port }}/health

# The read-only petedio-workspace-mirror App (PET-542). The vault is private and deploy keys
# are disabled org-wide, so each vault fetch carries a token scoped to petedio-vault alone.
LAB_GITHUB_APP_ID={{ lab_agent_github_app_id }}
LAB_GITHUB_APP_INSTALLATION_ID={{ lab_agent_github_installation_id }}
LAB_GITHUB_APP_KEY_FILE={{ lab_agent_github_key_file }}
LAB_VAULT_REPO=petedio-vault

# The lab MCP (PET-667), for claude.ai threads through pdlab.dev/mcp/lab. Off while
# lab_agent_access_aud is empty: the audience tag comes from Terraform's lab_mcp_access_aud
# output once the route is applied. lab-agent admits only the tunnel host and Pedro's email.
{% if lab_agent_access_aud | length > 0 %}
LAB_MCP_HOST={{ ansible_host }}
LAB_MCP_PORT={{ lab_agent_mcp_port }}
LAB_MCP_PEER={{ lab_agent_mcp_peer }}
LAB_ACCESS_TEAM_DOMAIN={{ lab_agent_access_team_domain }}
LAB_ACCESS_AUD={{ lab_agent_access_aud }}
LAB_ACCESS_EMAILS={{ lab_agent_access_emails | join(',') }}
{% endif %}

# The three read-only clones, fetched by lab-agent itself.
LAB_VAULT_CLONE={{ lab_agent_state_dir }}/vault
LAB_IAC_CLONE={{ lab_agent_state_dir }}/iac
LAB_MEDIA_IAC_CLONE={{ lab_agent_state_dir }}/media-iac
