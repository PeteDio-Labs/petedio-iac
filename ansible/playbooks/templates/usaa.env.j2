# petedio-usaa environment (PET-590). MANAGED BY ANSIBLE: configure-usaa.yml.
# Holds the database password and the Batsy bearer token, so it is root:{{ usaa_group }} 0640.
# The password is URL-encoded, including "/", which the urlencode filter leaves alone.
# systemd reads this file as EnvironmentFile=, so USAA_VIEWERS is single-quoted to keep its
# JSON double quotes literal.
PORT={{ usaa_port }}
HOST={{ usaa_host }}
DATABASE_URL=postgres://{{ usaa_db_user }}:{{ usaa_db_password | urlencode | replace('/', '%2F') }}@{{ usaa_db_host }}:{{ usaa_db_port }}/{{ usaa_db_name }}
USAA_BATSY_BEARER={{ usaa_batsy_bearer }}
USAA_ACCESS_TEAM_DOMAIN={{ usaa_access_team_domain }}
USAA_PUBLIC_ORIGIN={{ usaa_public_origin }}
USAA_FEED_HOST={{ usaa_feed_host }}
USAA_VIEWERS='{{ usaa_viewers | to_json }}'
