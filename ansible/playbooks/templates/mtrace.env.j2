# mtrace service environment. MANAGED BY ANSIBLE — edits here are overwritten.
#
# ⚠ No *arr API keys, deliberately. mtrace reads each key on the host that owns it and
# uses it on that host's loopback; nothing here is a media credential. See
# configure-media-dash.yml for why centralising them would have been a regression.
MEDIA_CONTROL_SSH_KEY={{ mtrace_dir }}/.ssh/id_ed25519_mtrace
HOME={{ mtrace_dir }}
# ⚠ THE LAN BIND, AND WHAT MAKES IT SAFE (PET-518). This process holds an SSH key that
# is root on six media hosts, which is exactly why it was loopback-only for so long. It
# now binds mtrace_bind because pete-bot's replacement caller needs to reach it directly,
# and that is safe ONLY because an nftables allowlist — table inet mtrace_allow, loaded by
# mtrace-allowlist.service BEFORE this unit is allowed to start — accepts this port from
# lo and from mtrace_allow_sources only, and resets everything else. Read that table's
# comments (templates/mtrace-allowlist.nft.j2) before touching this bind.
#
# What still holds: the SSH key this process carries is root on six media hosts. NEVER
# widen mtrace_allow_sources to the /24 — that turns one leaked caller token into a path
# to every media container mtrace reaches, which is precisely what the allowlist exists
# to prevent. Add a caller by name, not a subnet.
MEDIA_CONTROL_BIND={{ mtrace_bind }}
MEDIA_CONTROL_PORT={{ mtrace_port }}
# One token per caller, name:token pairs joined by ',' (dictsort order, so this file is
# stable across re-runs when the callers don't change). MEDIA_CONTROL_TOKEN (singular) is
# gone — see configure-media-dash.yml's header for where each field comes from.
MEDIA_CONTROL_TOKENS={{ mtrace_caller_tokens | dictsort | map('join', ':') | join(',') }}

# Ollama is OPTIONAL. /api/tool, /api/triage and /api/vpn never call it, and /api/ask
# falls back to deterministic keyword routing when ollama-host is asleep — which it is,
# often, being bare metal. Losing the model costs phrasing latitude, not answers.
OLLAMA_HOST=http://192.168.50.12:11434
MEDIA_CONTROL_MODEL=qwen3:8b
