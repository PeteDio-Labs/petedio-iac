# tracerr service environment. MANAGED BY ANSIBLE — edits here are overwritten.
#
# ⚠ No *arr API keys, deliberately. tracerr reads each key on the host that owns it and
# uses it on that host's loopback; nothing here is a media credential. See
# configure-media-dash.yml for why centralising them would have been a regression.
MEDIA_CONTROL_SSH_KEY={{ mtrace_dir }}/.ssh/id_ed25519_mtrace
HOME={{ mtrace_dir }}
# ⚠ THE LAN BIND, AND WHAT MAKES IT SAFE (PET-518). This process holds an SSH key that
# is root on six media hosts, which is exactly why it was loopback-only for so long. It
# now binds mtrace_bind because pete-bot's replacement caller needs to reach it directly,
# and that is safe ONLY because an nftables allowlist — table inet mtrace_allow, loaded by
# mtrace-allowlist.service BEFORE this unit is allowed to start — accepts this port from
# lo and from mtrace_allow_sources only, and resets everything else. Read that table's
# comments (templates/mtrace-allowlist.nft.j2) before touching this bind.
#
# What still holds: the SSH key this process carries is root on six media hosts. NEVER
# widen mtrace_allow_sources to the /24 — that turns one leaked caller token into a path
# to every media container tracerr reaches, which is precisely what the allowlist exists
# to prevent. Add a caller by name, not a subnet.
MEDIA_CONTROL_BIND={{ mtrace_bind }}
MEDIA_CONTROL_PORT={{ mtrace_port }}
# One token per caller, name:token pairs joined by ',' (dictsort order, so this file is
# stable across re-runs when the callers don't change). MEDIA_CONTROL_TOKEN (singular) is
# gone — see configure-media-dash.yml's header for where each field comes from.
MEDIA_CONTROL_TOKENS={{ mtrace_caller_tokens | dictsort | map('join', ':') | join(',') }}

# Callers allowed to use the write tools. Every other caller stays read-only. A name here
# that is not a caller above stops tracerr at startup (src/auth.ts parseWriters). `name:tool`
# limits the caller to that write tool (src/auth.ts parseWriterScopes); tracerr stops at startup
# on a scope that names no write tool, so deploy a tracerr that reads scopes first.
MEDIA_CONTROL_WRITERS={% for c in mtrace_write_callers %}{{ c }}{% if c in mtrace_write_scopes %}:{{ mtrace_write_scopes[c] | join('+') }}{% endif %}{{ ',' if not loop.last }}{% endfor %}

# The scheduled search for missing titles (MED-12). With mtrace_schedule 'on' it runs the
# same MoviesSearch and EpisodeSearch commands as search_missing, one title at a time, and
# logs one JSON line per title and one per pass. Any other value leaves it off.
MEDIA_CONTROL_SCHEDULE={{ mtrace_schedule }}
MEDIA_CONTROL_SEARCH_GAP_MS={{ mtrace_search_gap_ms }}
MEDIA_CONTROL_SEARCH_CAP={{ mtrace_search_cap }}
MEDIA_CONTROL_SCHEDULE_LOG={{ mtrace_schedule_log }}

{% if mtrace_mcp_access_aud | length > 0 %}
# The MCP door at /mcp/media (read tools only). All five are required; tracerr stops at
# startup on a partial set. The audience tag is Terraform's media_mcp_subdomain_access_aud.
MEDIA_CONTROL_MCP_PORT={{ mtrace_mcp_port }}
MEDIA_CONTROL_MCP_PEER={{ mtrace_mcp_peer }}
MEDIA_CONTROL_MCP_TEAM={{ mtrace_mcp_access_team_domain }}
MEDIA_CONTROL_MCP_AUD={{ mtrace_mcp_access_aud }}
MEDIA_CONTROL_MCP_EMAILS={{ mtrace_mcp_access_emails | join(',') }}
MEDIA_CONTROL_MCP_AGENTS={% for name, cid in (mtrace_mcp_access_agents | default({})) | dictsort %}{{ cid }}={{ name }}{{ ',' if not loop.last }}{% endfor %}
{% else %}
# mtrace_mcp_access_aud is empty, so the MCP door is off.
{% endif %}

# No OLLAMA_HOST or MEDIA_CONTROL_MODEL: tracerr routes by keyword and calls no model
# (PET-525).
