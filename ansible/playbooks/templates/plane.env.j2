{#
  plane.env — rendered by configure-plane.yml. NEVER commit a filled-in copy: every
  secret below comes from Vault via no_log extra-vars.

  EVERY VARIABLE HERE WAS TAKEN FROM THE ACTUAL COMPOSE FILE
  (deployments/cli/community/docker-compose.yml at the pinned tag), not from a blog
  post. An earlier draft of this template invented NGINX_PORT, GUNICORN_WORKERS,
  POSTGRES_HOST and BUCKET_NAME — none of which Plane reads — while omitting
  APP_RELEASE, SITE_ADDRESS, LISTEN_HTTP_PORT and LIVE_SERVER_SECRET_KEY, which it
  requires. If you bump plane_release, re-derive this list from the new file.
#}
# ---- release ----------------------------------------------------------------------
# Every image is makeplane/*:${APP_RELEASE:-stable}. Pinning this is the whole point of
# pinning plane_release — leaving it unset silently tracks `stable`.
APP_RELEASE={{ plane_version }}

# ---- web / proxy ------------------------------------------------------------------
# Tailnet-only: the LAN address IS the site address. No TLS here on purpose — there is
# no public edge, and Tailscale already encrypts the path.
WEB_URL=http://{{ plane_host_ip }}:{{ plane_web_port }}
APP_DOMAIN={{ plane_host_ip }}:{{ plane_web_port }}
SITE_ADDRESS=:{{ plane_web_port }}
LISTEN_HTTP_PORT={{ plane_web_port }}
LISTEN_HTTPS_PORT=443
CORS_ALLOWED_ORIGINS=http://{{ plane_host_ip }}:{{ plane_web_port }}
API_BASE_URL=http://api:8000
DEBUG=0
SECRET_KEY={{ plane_secret_key }}
LIVE_SERVER_SECRET_KEY={{ plane_live_secret_key }}

# Webhooks fire from the api container at LAN targets, so the allow-lists must permit
# private ranges — Plane blocks them by default to prevent SSRF. This is a deliberate
# relaxation and it is safe ONLY because this instance is not publicly reachable.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOWED_IPS=

# ---- database: EXTERNAL on postgres-231 -------------------------------------------
# The bundled plane-db service is scaled to 0 by docker-compose.override.yml. These
# values are what actually point Plane at 231.
PGHOST={{ pg_host }}
POSTGRES_PORT=5432
PGDATABASE={{ pg_db }}
POSTGRES_DB={{ pg_db }}
POSTGRES_USER={{ pg_user }}
POSTGRES_PASSWORD={{ plane_db_password }}
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://{{ pg_user }}:{{ plane_db_password }}@{{ pg_host }}:5432/{{ pg_db }}

# ---- redis + rabbitmq: BUNDLED ----------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD={{ plane_mq_password }}
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:{{ plane_mq_password }}@plane-mq:5672/plane

# ---- object storage: EXTERNAL on minio-data-245 -----------------------------------
# USE_MINIO=0 tells Plane not to expect the bundled MinIO; the override file is what
# actually stops the container from running.
USE_MINIO=0
MINIO_ENDPOINT_SSL=0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID={{ plane_minio_access_key }}
AWS_SECRET_ACCESS_KEY={{ plane_minio_secret_key }}
AWS_S3_ENDPOINT_URL={{ minio_endpoint }}
AWS_S3_BUCKET_NAME={{ minio_bucket }}

# 50 MB. Raised well past the 5 MB default; there is no Cloudflare edge in this path,
# so the 100 MB request-body cap that constrains a tunnelled deployment does not apply.
FILE_SIZE_LIMIT=52428800

# ---- scale ------------------------------------------------------------------------
# One user. One replica of everything; two api workers for a little concurrency.
WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
LIVE_REPLICAS=1
API_REPLICAS=2
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
API_KEY_RATE_LIMIT=120/minute
