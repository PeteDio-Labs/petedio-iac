# {{ ansible_managed }}
# pete-bot — Discord surface for the homelab (PET-375).
#
# Read by systemd as an EnvironmentFile, so it is 0640 root:{{ pete_bot_user }}.
# Every value here comes from Vault via scripts/deploy-pete-bot.sh; none is defaulted
# in the role and none appears in the repo.
DISCORD_TOKEN={{ pete_bot_discord_token }}
DISCORD_CLIENT_ID={{ pete_bot_discord_client_id }}
OWNER_USER_ID={{ pete_bot_owner_user_id }}

# Alert intake. Uptime Kuma posts here; it cannot sign a body, so this is a bearer.
HTTP_SERVER_ENABLED=true
HTTP_SERVER_PORT={{ pete_bot_port }}
ALERT_BEARER_TOKEN={{ pete_bot_alert_bearer }}
# Session intake (PET-584). notify-pedro on the session hosts posts here, with its own
# bearer, so a session host holds nothing that can post a fake alert.
NOTIFY_BEARER_TOKEN={{ pete_bot_notify_bearer }}

# One DM per incident (PET-384). Monitors that fail within the window share a message,
# so a node reboot taking eight services down reads as one event rather than eight.
#
# ⚠ THE WINDOW IS BOUNDED ON PURPOSE. Editing a message raises no Discord
# notification, so an unbounded window would fold a brand-new outage silently into an
# old message — the exact failure PET-374 exists to end. Set 0 to disable grouping.
ALERT_COALESCE_MS={{ pete_bot_alert_coalesce_ms | default(60000) }}

# Open incidents, so a restart between DOWN and UP still edits the original DM. The
# directory is created by StateDirectory= in the unit; it is the only path this process
# can write. Empty means memory only, which costs edit-in-place across a restart.
ALERT_STATE_PATH=/var/lib/pete-bot/alerts.json

# /update (PET-395). pete-bot starts petedio-media-iac's media-updates.yml and reads the
# run back; the run holds every privilege. This token can run workflows in that one repo
# and nothing else. Empty leaves /update answering that it is not configured.
GITHUB_UPDATES_TOKEN={{ pete_bot_github_updates_token | default('') }}
UPDATES_REPO=PeteDio-Labs/petedio-media-iac
UPDATES_WORKFLOW=media-updates.yml

# The Anthropic API gateway (PET-617). Empty ANTHROPIC_API_KEY leaves it off.
#
# ⚠ SINGLE QUOTES AROUND THE JSON. systemd reads a single-quoted value literally, so the
# double quotes and braces reach the process as written. Unquoted, a backslash in a value
# would be taken as an escape. The bearers are URL-safe base64 and hold no quote.
ANTHROPIC_API_KEY={{ pete_bot_anthropic_api_key | default('') }}
{% if pete_bot_anthropic_api_key | default('') | length > 0 %}
LLM_GATEWAY_CALLERS='{{ pete_bot_llm_callers | to_json }}'
{% else %}
LLM_GATEWAY_CALLERS=
{% endif %}
LLM_LEDGER_PATH={{ pete_bot_llm_ledger_path }}

METRICS_ENABLED=false
LOG_LEVEL=info
