#!/bin/sh
# {{ ansible_managed }}
# plane-mcp-firewall: restrict the plane-mcp shim's ports to the cloudflared tunnel host.
# Rendered by configure-plane.yml (PET-292, PET-610, PET-650). plane-mcp-firewall.service runs it
# before Docker starts, and again on reload.
#
# Each port's Caddy site swaps in a Plane PAT, and Caddy checks no Access JWT, so this
# firewall is the only thing between the LAN and acting as that PAT's owner in Plane.
#
# The rules sit in the raw table's PREROUTING chain, for three reasons:
#   - raw PREROUTING runs before Docker's DNAT, so a published port cannot skip it.
#   - The chain exists before dockerd starts, so the unit can run Before=docker.service and
#     a boot never publishes a port ahead of its rule. DOCKER-USER does not exist until
#     dockerd creates it.
#   - `! -i lo` exempts loopback, so the playbook's health checks on 127.0.0.1 still pass.
#
# IPv6 gets the same DROP with no allowed source, because the tunnel reaches 235 over IPv4.
# Compose publishes every port on IPv4 only, so this is a second line, not the only one.
#
# Idempotent: every insert tests with -C first.
set -eu

tunnel_host={{ plane_mcp_tunnel_host }}

for port in {{ plane_mcp_ports | join(' ') }}; do
  v4="! -i lo -p tcp --dport $port ! -s $tunnel_host -j DROP"
  v6="! -i lo -p tcp --dport $port -j DROP"
  # shellcheck disable=SC2086 # the rule must split into arguments
  iptables -t raw -C PREROUTING $v4 2>/dev/null || iptables -t raw -I PREROUTING 1 $v4
  # shellcheck disable=SC2086
  ip6tables -t raw -C PREROUTING $v6 2>/dev/null || ip6tables -t raw -I PREROUTING 1 $v6

  # Remove the DOCKER-USER rules that this unit placed before PET-610's fix. After the first
  # run on 235, and on every boot, they are absent and these loops do nothing.
  while iptables -D DOCKER-USER -p tcp --dport "$port" -s "$tunnel_host" -j RETURN 2>/dev/null; do :; done
  while iptables -D DOCKER-USER -p tcp --dport "$port" -j DROP 2>/dev/null; do :; done
done
