{#
  plane-mcp.env — rendered by configure-plane.yml into /opt/plane-mcp/ (PET-292, PET-610).
  NEVER commit a filled-in copy. PLANE_API_KEY is Pedro's Plane PAT at kv/services/plane
  field `api_key`, for the :8790 site. PLANE_TOM_API_KEY is Tom's at kv/services/plane-tom
  field `api_key`, for the :8791 site. scripts/deploy-plane.sh passes both as no_log
  extra-vars. Both containers in the MCP stack read this file: plane-mcp-server for the base
  URL and workspace, and Caddy for the PAT it swaps into the Authorization header.

  Apart from PLANE_TOM_API_KEY, the lines below reproduce the hand-built file found on 235
  on 2026-10-13 byte for byte.
#}
PLANE_API_KEY={{ plane_mcp_api_key }}
PLANE_TOM_API_KEY={{ plane_mcp_tom_api_key }}
PLANE_WORKSPACE_SLUG={{ plane_workspace_slug }}
PLANE_BASE_URL=http://{{ plane_host_ip }}:{{ plane_web_port }}
# The /http (Plane-OAuth) and /sse mounts are built unconditionally in http mode
# and refuse to construct without these, so they exist ONLY to let the process
# boot. They are deliberately non-functional: Caddy 404s every path except /mcp
# (-> /http/api-key/mcp) and /healthz, and these values can authorize nobody.
PLANE_OAUTH_PROVIDER_CLIENT_ID=unused-oauth-mount-not-routed
PLANE_OAUTH_PROVIDER_CLIENT_SECRET=unused-oauth-mount-not-routed
PLANE_OAUTH_PROVIDER_BASE_URL=http://127.0.0.1:8211
