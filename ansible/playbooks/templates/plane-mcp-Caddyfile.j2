# {{ ansible_managed }}
# Access-gated shim in front of plane-mcp-server (PET-292). Rendered by configure-plane.yml.
#
# The MCP server's /http/api-key mount takes the Plane PAT in a header and runs
# NO OAuth of its own — the only mount compatible with Cloudflare Access Managed
# OAuth, which is documented as incompatible with origins that run their own.
#
# Claude sends `Authorization: Bearer <opaque Access token>`; the server needs
# `Authorization: Bearer <Plane PAT>`. That swap is this file's whole job.
#
# PLANE_API_KEY is the Claude Member user's PAT (PET-660), not Pedro's.
#
# Everything else passes through untouched — importantly Mcp-Method, Mcp-Name and
# MCP-Protocol-Version, which the 2026-07-28 spec requires and gateways route on.
{
	admin off
	auto_https off
}

:8790 {
	log {
		output stdout
		format console
	}

	# pdlab.dev/mcp/plane reaches this site too (PET-667). cloudflared passes the path
	# through unchanged, so map it to the same mount. It comes first because the @mcp
	# matcher below also matches /mcp/plane and would rewrite it to the wrong path.
	@plane path /mcp/plane /mcp/plane/*
	handle @plane {
		uri replace /mcp/plane /http/api-key/mcp
		reverse_proxy plane-mcp:8211 {
			header_up Authorization "Bearer {env.PLANE_API_KEY}"
			header_up X-Workspace-slug {env.PLANE_WORKSPACE_SLUG}
		}
	}

	# Public path is /mcp; upstream really lives at /http/api-key/mcp.
	@mcp path /mcp /mcp/*
	handle @mcp {
		uri replace /mcp /http/api-key/mcp
		reverse_proxy plane-mcp:8211 {
			header_up Authorization "Bearer {env.PLANE_API_KEY}"
			header_up X-Workspace-slug {env.PLANE_WORKSPACE_SLUG}
		}
	}

	# Liveness for the tunnel/origin check. Deliberately says nothing useful.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "not found" 404
	}
}

# One site per entry in plane_mcp_members (PET-610, PET-650): the same shim with that person's
# PAT. mcp-<name>.pdlab.dev reaches it through the tunnel, and Access admits only that
# person's email. Plane scopes every call to the person's own roles, so the port can do only
# what they can do in the web app. Each site stays a copy of :8790 with one difference, the PAT.
{% for m in plane_mcp_members %}
:{{ m.port }} {
	log {
		output stdout
		format console
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		uri replace /mcp /http/api-key/mcp
		reverse_proxy plane-mcp:8211 {
			header_up Authorization "Bearer {env.PLANE_{{ m.name | upper }}_API_KEY}"
			header_up X-Workspace-slug {env.PLANE_WORKSPACE_SLUG}
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "not found" 404
	}
}

{% endfor %}
