# {{ ansible_managed }}
# Secrets for the water-fast service. Mode 0640, owned by the service user — this is why
# they are here rather than Environment= lines in the unit (which `systemctl show` exposes
# to any local user).
DATABASE_URL=postgres://{{ waterfast_db_user }}:{{ waterfast_db_password | urlencode }}@{{ waterfast_db_host }}:{{ waterfast_db_port }}/{{ waterfast_db_name }}
CF_ACCESS_TEAM_DOMAIN={{ waterfast_cf_access_team_domain }}
CF_ACCESS_AUD={{ waterfast_cf_access_aud }}
