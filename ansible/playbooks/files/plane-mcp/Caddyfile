# Access-gated shim in front of plane-mcp-server (PET-292).
#
# The MCP server's /http/api-key mount takes the Plane PAT in a header and runs
# NO OAuth of its own — the only mount compatible with Cloudflare Access Managed
# OAuth, which is documented as incompatible with origins that run their own.
#
# Claude sends `Authorization: Bearer <opaque Access token>`; the server needs
# `Authorization: Bearer <Plane PAT>`. That swap is this file's whole job.
#
# Everything else passes through untouched — importantly Mcp-Method, Mcp-Name and
# MCP-Protocol-Version, which the 2026-07-28 spec requires and gateways route on.
{
	admin off
	auto_https off
}

:8790 {
	log {
		output stdout
		format console
	}

	# Public path is /mcp; upstream really lives at /http/api-key/mcp.
	@mcp path /mcp /mcp/*
	handle @mcp {
		uri replace /mcp /http/api-key/mcp
		reverse_proxy plane-mcp:8211 {
			header_up Authorization "Bearer {env.PLANE_API_KEY}"
			header_up X-Workspace-slug {env.PLANE_WORKSPACE_SLUG}
		}
	}

	# Liveness for the tunnel/origin check. Deliberately says nothing useful.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "not found" 404
	}
}

# Tom's site (PET-610), the same shim with Tom's PAT. mcp-tom.pdlab.dev reaches it through
# the tunnel, and Access admits only Tom's email. Plane scopes every call to Tom's own roles,
# so this port can do only what Tom can do in the web app. Keep it a copy of :8790 with one
# difference, the PAT.
:8791 {
	log {
		output stdout
		format console
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		uri replace /mcp /http/api-key/mcp
		reverse_proxy plane-mcp:8211 {
			header_up Authorization "Bearer {env.PLANE_TOM_API_KEY}"
			header_up X-Workspace-slug {env.PLANE_WORKSPACE_SLUG}
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "not found" 404
	}
}
