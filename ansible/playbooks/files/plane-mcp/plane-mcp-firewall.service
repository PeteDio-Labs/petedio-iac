[Unit]
# The shim on :8790 and :8791 holds a Plane PAT per port, and it must answer only the
# cloudflared tunnel host (LXC 112). /usr/local/sbin/plane-mcp-firewall sets the rules and
# explains them.
#
# FAIL CLOSED. The unit runs before docker.service, and docker.service requires it through
# the RequiredBy= symlink below. When the rules cannot be set, Docker does not start, so no
# port is ever published unguarded. That takes the Plane tracker down with it, on purpose.
#
# ⚠ NEVER restart or stop this unit. Docker requires it, so a stop or restart propagates to
# docker.service and restarts every container on 235, the tracker included. RefuseManualStop
# blocks both. To re-apply the rules, run `systemctl reload plane-mcp-firewall`, which does
# not propagate. iptables rules do not survive a reboot and netfilter-persistent is not
# installed here, so this unit is the persistence.
Description=Restrict the plane-mcp shim (:8790, :8791) to the cloudflared tunnel host
Before=docker.service
RefuseManualStop=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/plane-mcp-firewall
ExecReload=/usr/local/sbin/plane-mcp-firewall

[Install]
RequiredBy=docker.service
WantedBy=multi-user.target
